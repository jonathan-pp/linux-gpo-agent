[Unit]
Description=Stratégies de groupe (GPO) de l'utilisateur, à l'ouverture de session
After=graphical-session-pre.target dbus.socket

[Service]
Type=oneshot
ExecStart=/usr/bin/linux-gpo utilisateur --ouverture
# profil de bureau : attend l’installation des applications manquantes (service système)
TimeoutStartSec=45min

[Install]
WantedBy=default.target
