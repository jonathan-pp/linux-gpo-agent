// linux-gpo : « gpupdate » lancé par un utilisateur d'une session locale peut démarrer le passage des stratégies de
// l'ordinateur (et rien d'autre : ce service ne fait qu'appliquer les GPO publiées par les administrateurs du domaine).
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" && action.lookup("unit") == "linux-gpo.service" &&
      action.lookup("verb") == "start" && subject.local && subject.active) {
    return polkit.Result.YES;
  }
});
