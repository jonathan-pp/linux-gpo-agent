<?xml version="1.0" encoding="utf-8"?>
<!-- Généré par admx/generer.py (linux-gpo) : ne pas modifier à la main. -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="linuxgpo" namespace="LinuxGPO.Policies.LinuxGPO"/>
    <using prefix="windows" namespace="Microsoft.Policies.Windows"/>
  </policyNamespaces>
  <resources minRequiredRevision="1.0"/>
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_LinuxGPO" displayName="$(string.SUPPORTED_LinuxGPO)"/>
    </definitions>
  </supportedOn>
  <categories>
    <category name="Linux" displayName="$(string.cat_Linux)"></category>
    <category name="Bureau" displayName="$(string.cat_Bureau)"><parentCategory ref="Linux"/></category>
    <category name="Droits" displayName="$(string.cat_Droits)"><parentCategory ref="Linux"/></category>
    <category name="Securite" displayName="$(string.cat_Securite)"><parentCategory ref="Linux"/></category>
    <category name="Systeme" displayName="$(string.cat_Systeme)"><parentCategory ref="Linux"/></category>
    <category name="Logiciels" displayName="$(string.cat_Logiciels)"><parentCategory ref="Linux"/></category>
  </categories>
  <policies>
    <policy name="DisableCommandLine" class="Both" displayName="$(string.DisableCommandLine)" explainText="$(string.DisableCommandLine_Aide)" key="Software\Policies\LinuxGPO\Desktop" valueName="DisableCommandLine"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="DisablePrinting" class="Machine" displayName="$(string.DisablePrinting)" explainText="$(string.DisablePrinting_Aide)" key="Software\Policies\LinuxGPO\Desktop" valueName="DisablePrinting"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="DisableSaveToDisk" class="Machine" displayName="$(string.DisableSaveToDisk)" explainText="$(string.DisableSaveToDisk_Aide)" key="Software\Policies\LinuxGPO\Desktop" valueName="DisableSaveToDisk"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="DisableLogout" class="Machine" displayName="$(string.DisableLogout)" explainText="$(string.DisableLogout_Aide)" key="Software\Policies\LinuxGPO\Desktop" valueName="DisableLogout"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="DisableUserSwitching" class="Machine" displayName="$(string.DisableUserSwitching)" explainText="$(string.DisableUserSwitching_Aide)" key="Software\Policies\LinuxGPO\Desktop" valueName="DisableUserSwitching"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="LockDelay" class="Both" displayName="$(string.LockDelay)" explainText="$(string.LockDelay_Aide)" key="Software\Policies\LinuxGPO\Desktop" presentation="$(presentation.LockDelay)"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><decimal id="LockDelay" valueName="LockDelay" minValue="60" maxValue="86400"/></elements></policy>
    <policy name="Wallpaper" class="Both" displayName="$(string.Wallpaper)" explainText="$(string.Wallpaper_Aide)" key="Software\Policies\LinuxGPO\Desktop" presentation="$(presentation.Wallpaper)"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><text id="Wallpaper" valueName="Wallpaper"/></elements></policy>
    <policy name="HideUserList" class="Machine" displayName="$(string.HideUserList)" explainText="$(string.HideUserList_Aide)" key="Software\Policies\LinuxGPO\Desktop" valueName="HideUserList"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="LoginBanner" class="Machine" displayName="$(string.LoginBanner)" explainText="$(string.LoginBanner_Aide)" key="Software\Policies\LinuxGPO\Desktop" presentation="$(presentation.LoginBanner)"><parentCategory ref="Bureau"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><multiText id="LoginBanner" valueName="LoginBanner"/></elements></policy>
    <policy name="DenyRemovableStorage" class="Machine" displayName="$(string.DenyRemovableStorage)" explainText="$(string.DenyRemovableStorage_Aide)" key="Software\Policies\LinuxGPO\Devices" presentation="$(presentation.DenyRemovableStorage)"><parentCategory ref="Droits"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><enum id="DenyRemovableStorage" valueName="DenyRemovableStorage"><item displayName="$(string.DenyRemovableStorage_1)"><value><decimal value="1"/></value></item><item displayName="$(string.DenyRemovableStorage_2)"><value><decimal value="2"/></value></item></enum></elements></policy>
    <policy name="DenyPowerOff" class="Machine" displayName="$(string.DenyPowerOff)" explainText="$(string.DenyPowerOff_Aide)" key="Software\Policies\LinuxGPO\Permissions" valueName="DenyPowerOff"><parentCategory ref="Droits"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="DenySoftwareInstall" class="Machine" displayName="$(string.DenySoftwareInstall)" explainText="$(string.DenySoftwareInstall_Aide)" key="Software\Policies\LinuxGPO\Permissions" valueName="DenySoftwareInstall"><parentCategory ref="Droits"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="DenyNetworkConfig" class="Machine" displayName="$(string.DenyNetworkConfig)" explainText="$(string.DenyNetworkConfig_Aide)" key="Software\Policies\LinuxGPO\Permissions" valueName="DenyNetworkConfig"><parentCategory ref="Droits"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue></policy>
    <policy name="AdminGroups" class="Machine" displayName="$(string.AdminGroups)" explainText="$(string.AdminGroups_Aide)" key="Software\Policies\LinuxGPO\Permissions" presentation="$(presentation.AdminGroups)"><parentCategory ref="Droits"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><text id="AdminGroups" valueName="AdminGroups"/></elements></policy>
    <policy name="SudoRules" class="Machine" displayName="$(string.SudoRules)" explainText="$(string.SudoRules_Aide)" key="Software\Policies\LinuxGPO\Sudo\Rules" presentation="$(presentation.SudoRules)"><parentCategory ref="Securite"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="SudoRules" key="Software\Policies\LinuxGPO\Sudo\Rules" valuePrefix=""/></elements></policy>
    <policy name="AccessAllow" class="Machine" displayName="$(string.AccessAllow)" explainText="$(string.AccessAllow_Aide)" key="Software\Policies\LinuxGPO\Access\Allow" presentation="$(presentation.AccessAllow)"><parentCategory ref="Securite"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="AccessAllow" key="Software\Policies\LinuxGPO\Access\Allow" valuePrefix=""/></elements></policy>
    <policy name="AccessDeny" class="Machine" displayName="$(string.AccessDeny)" explainText="$(string.AccessDeny_Aide)" key="Software\Policies\LinuxGPO\Access\Deny" presentation="$(presentation.AccessDeny)"><parentCategory ref="Securite"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="AccessDeny" key="Software\Policies\LinuxGPO\Access\Deny" valuePrefix=""/></elements></policy>
    <policy name="Ssh" class="Machine" displayName="$(string.Ssh)" explainText="$(string.Ssh_Aide)" key="Software\Policies\LinuxGPO\SSH" presentation="$(presentation.Ssh)"><parentCategory ref="Securite"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="Ssh" key="Software\Policies\LinuxGPO\SSH" explicitValue="true"/></elements></policy>
    <policy name="FirewallRules" class="Machine" displayName="$(string.FirewallRules)" explainText="$(string.FirewallRules_Aide)" key="Software\Policies\LinuxGPO\Firewall\Rules" presentation="$(presentation.FirewallRules)"><parentCategory ref="Securite"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="FirewallRules" key="Software\Policies\LinuxGPO\Firewall\Rules" valuePrefix=""/></elements></policy>
    <policy name="Messages" class="Machine" displayName="$(string.Messages)" explainText="$(string.Messages_Aide)" key="Software\Policies\LinuxGPO\Messages" presentation="$(presentation.Messages)"><parentCategory ref="Systeme"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><multiText id="issue" valueName="issue"/><multiText id="motd" valueName="motd"/></elements></policy>
    <policy name="Updates" class="Machine" displayName="$(string.Updates)" explainText="$(string.Updates_Aide)" key="Software\Policies\LinuxGPO\Updates" presentation="$(presentation.Updates)"><parentCategory ref="Systeme"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><enum id="Mode" valueName="Mode"><item displayName="$(string.Mode_0)"><value><decimal value="0"/></value></item><item displayName="$(string.Mode_1)"><value><decimal value="1"/></value></item><item displayName="$(string.Mode_2)"><value><decimal value="2"/></value></item></enum><text id="Time" valueName="Time"/><boolean id="Reboot" valueName="Reboot"><trueValue><decimal value="1"/></trueValue><falseValue><decimal value="0"/></falseValue></boolean></elements></policy>
    <policy name="Time" class="Machine" displayName="$(string.Time)" explainText="$(string.Time_Aide)" key="Software\Policies\LinuxGPO\Time" presentation="$(presentation.Time)" valueName="UseDomainTime"><parentCategory ref="Systeme"/><supportedOn ref="SUPPORTED_LinuxGPO"/><enabledValue><decimal value="1"/></enabledValue><disabledValue><decimal value="0"/></disabledValue><elements><text id="NtpServers" valueName="NtpServers"/></elements></policy>
    <policy name="Files" class="Machine" displayName="$(string.Files)" explainText="$(string.Files_Aide)" key="Software\Policies\LinuxGPO\Files" presentation="$(presentation.Files)"><parentCategory ref="Systeme"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="Files" key="Software\Policies\LinuxGPO\Files" explicitValue="true"/></elements></policy>
    <policy name="SoftwareInstall" class="Machine" displayName="$(string.SoftwareInstall)" explainText="$(string.SoftwareInstall_Aide)" key="Software\Policies\LinuxGPO\Software\Install" presentation="$(presentation.SoftwareInstall)"><parentCategory ref="Logiciels"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="SoftwareInstall" key="Software\Policies\LinuxGPO\Software\Install" valuePrefix=""/></elements></policy>
    <policy name="SoftwareRemove" class="Machine" displayName="$(string.SoftwareRemove)" explainText="$(string.SoftwareRemove_Aide)" key="Software\Policies\LinuxGPO\Software\Remove" presentation="$(presentation.SoftwareRemove)"><parentCategory ref="Logiciels"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="SoftwareRemove" key="Software\Policies\LinuxGPO\Software\Remove" valuePrefix=""/></elements></policy>
    <policy name="Flatpak" class="Machine" displayName="$(string.Flatpak)" explainText="$(string.Flatpak_Aide)" key="Software\Policies\LinuxGPO\Software\Flatpak" presentation="$(presentation.Flatpak)"><parentCategory ref="Logiciels"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="Flatpak" key="Software\Policies\LinuxGPO\Software\Flatpak" valuePrefix=""/></elements></policy>
    <policy name="StartupScripts" class="Machine" displayName="$(string.StartupScripts)" explainText="$(string.StartupScripts_Aide)" key="Software\Policies\LinuxGPO\Scripts\Startup" presentation="$(presentation.StartupScripts)"><parentCategory ref="Logiciels"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="StartupScripts" key="Software\Policies\LinuxGPO\Scripts\Startup" explicitValue="true"/></elements></policy>
    <policy name="DailyScripts" class="Machine" displayName="$(string.DailyScripts)" explainText="$(string.DailyScripts_Aide)" key="Software\Policies\LinuxGPO\Scripts\Daily" presentation="$(presentation.DailyScripts)"><parentCategory ref="Logiciels"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="DailyScripts" key="Software\Policies\LinuxGPO\Scripts\Daily" explicitValue="true"/></elements></policy>
    <policy name="LogonScripts" class="User" displayName="$(string.LogonScripts)" explainText="$(string.LogonScripts_Aide)" key="Software\Policies\LinuxGPO\Scripts\Logon" presentation="$(presentation.LogonScripts)"><parentCategory ref="Logiciels"/><supportedOn ref="SUPPORTED_LinuxGPO"/><elements><list id="LogonScripts" key="Software\Policies\LinuxGPO\Scripts\Logon" explicitValue="true"/></elements></policy>
  </policies>
</policyDefinitions>
